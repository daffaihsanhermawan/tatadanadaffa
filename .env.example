# ==============================================================================
# TataDana Environment Configuration
# All keys must be set in production. Never commit production secrets.
# ==============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=tatadana-exports

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
WEBHOOK_BASE_URL=https://tatadana.example.com

# AI Providers (can also be dynamically configured via Admin Dashboard)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=your-midtrans-server-key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_IS_PRODUCTION=false

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App Security
APP_ENCRYPTION_SECRET=tatadana-super-secret-key-32chars!!
